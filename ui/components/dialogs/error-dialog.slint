import { ScrollView, StandardButton, Button } from "std-widgets.slint";
import { CustomButton } from "../../custom-widgets/custom-button.slint";

export component ErrorDialog inherits Dialog {
    in property <string> error_message;

    preferred-height: 250px;
    preferred-width: 300px;

    ScrollView {
        height: 80%;
        width: 100%;
        
        Text {
            height: 100%;
            width: 100%;

            text: "An error has occurred: " + error_message;
            font-size: 12px;
        }
    }
    StandardButton {
        kind: ok;
    }
}