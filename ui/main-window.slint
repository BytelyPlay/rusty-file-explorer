import { FsEntry } from "components/fs-entry.slint";
import { Theme } from "globals/theme.slint";
import {
    DisplayableFsEntryData,
} from "structs/displayable-fs-entry-data.slint";
import { FilesBox } from "components/files-box.slint";
import { Callbacks } from "globals/callbacks.slint";
import { State } from "globals/state.slint";
import { ErrorDialog } from "components/dialogs/error-dialog.slint";
import { CustomText } from "custom-widgets/custom-text.slint";
import { ScrollView, TextEdit, LineEdit } from "std-widgets.slint";

export { DisplayableFsEntryData, FilesBox, Callbacks, State, ErrorDialog }
export component MainWindow inherits Window {
    preferred-height: 540px;
    preferred-width: 600px;

    VerticalLayout {
        x: 0;
        y: 0;

        height: 100%;
        width: 100%;

        padding: 0;
        spacing: 2px;

        Rectangle {
            height: 24px;
            width: parent.width - 4px;

            border-width: 4px;
            border-color: gray;

            border-radius: Theme.round_corner_border_radius;

            z: 2;

            edit_dir := LineEdit {
                height: parent.height - 4px;
                width: parent.width - 4px;

                input-method-hints: {
                    capitalization: CapitalizationMode.none,
                    auto-correct: false,
                    auto-complete: false
                };

                x: 4px;
                z: 1;

                font-size: 12px;

                text: State.currently_open_directory;

                accepted(text) => {
                    edit_dir.clear-focus();
                    Callbacks.directory_updated(text);
                }
        }
    }

    FilesBox {
        height: 80%;
        width: 80%;

        // x: parent.width - self.width;
            // y: parent.height - self.height;

            files: State.files;
        fs_entry_clicked(data) => Callbacks.fs_entry_clicked(data);
    }
}

}
