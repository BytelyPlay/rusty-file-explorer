import { FsEntry } from "components/fs-entry.slint";
import { Theme } from "globals/theme.slint";
import {
    DisplayableFsEntryData,
} from "structs/displayable-fs-entry-data.slint";
import { FilesBox } from "components/files-box.slint";
import { Callbacks } from "globals/callbacks.slint";
import { State } from "globals/state.slint";
import { ErrorDialog } from "components/dialogs/error-dialog.slint";

export { DisplayableFsEntryData, FilesBox, Callbacks, State, ErrorDialog }
export component MainWindow inherits Window {
    preferred-height: 540px;
    preferred-width: 600px;

    VerticalLayout {
        x: 0;
        y: 0;

        height: 100%;
        width: 100%;

        padding: 0;
        spacing: 0;

        Text {
            height: 5%;
            width: 100%;

            font-size: 18px;

            text: State.currently_open_directory;
        }

        FilesBox {
            height: 80%;
            width: 80%;

            // x: parent.width - self.width;
            // y: parent.height - self.height;

            files: State.files;
            fs_entry_clicked(data) => Callbacks.fs_entry_clicked(data);
        }
    }
}
